  <diagram id="camt-net-architecture" name="CAMT-Net Overall Architecture">
    <mxGraphModel dx="1252" dy="2193" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2260" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="input_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4776B8;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;BSM sequence input&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;X ∈ ℝ&lt;sup&gt;B×32×19&lt;/sup&gt;&lt;br&gt;32 consecutive messages&lt;br&gt;19 retained features&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="180" x="40" y="250" as="geometry" />
        </mxCell>
        <mxCell id="stem_5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#B98520;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;Kinematic-difference stem&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;Δx&lt;sub&gt;t&lt;/sub&gt; = x&lt;sub&gt;t&lt;/sub&gt; − x&lt;sub&gt;t−1&lt;/sub&gt;; first step = 0&lt;br&gt;Δ²x computed from Δx; first step = 0&lt;br&gt;Concatenate [x, Δx, Δ²x] → 57 channels&lt;br&gt;BatchNorm1d → S ∈ ℝ&lt;sup&gt;B×32×57&lt;/sup&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="175" width="245" x="260" y="235" as="geometry" />
        </mxCell>
        <mxCell id="branch_a_label_6" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#278778;fontFamily=Times New Roman;fontSize=15;spacing=0;fontStyle=1" value="&lt;div style=&quot;color: rgb(39, 135, 120); text-align: center;&quot;&gt;BRANCH A · LOCAL FEATURES + SEQUENTIAL DYNAMICS&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="540" x="475" y="120" as="geometry" />
        </mxCell>
        <mxCell id="branch_b_label_7" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;fontColor=#4776B8;fontFamily=Times New Roman;fontSize=15;spacing=0;fontStyle=1" value="&lt;div style=&quot;color: rgb(71, 118, 184); text-align: center;&quot;&gt;BRANCH B · GLOBAL TEMPORAL CONTEXT&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="540" x="540" y="365" as="geometry" />
        </mxCell>
        <mxCell id="cnn_8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F5F1;strokeColor=#278778;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;Two Conv1D blocks&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;Conv1D 57→96 (k=3, p=1) → BN → GELU&lt;br&gt;Conv1D 96→96 (k=3, p=1) → BN → GELU&lt;br&gt;Output A ∈ ℝ&lt;sup&gt;B×32×96&lt;/sup&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="245" x="545" y="165" as="geometry" />
        </mxCell>
        <mxCell id="mamba_9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5F5F1;strokeColor=#278778;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;Mamba / selective SSM × 2&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;Each block: LayerNorm → Mamba&lt;br&gt;d_state=16, d_conv=4, expand=2&lt;br&gt;Dropout + residual; final LayerNorm&lt;br&gt;Output A ∈ ℝ&lt;sup&gt;B×32×96&lt;/sup&gt;&lt;br&gt;&lt;i&gt;Pure-PyTorch SSM in recorded run&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="255" x="825" y="165" as="geometry" />
        </mxCell>
        <mxCell id="projection_10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4776B8;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;Input projection + position&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;Linear 57→96&lt;br&gt;Add learned positional encoding&lt;br&gt;P ∈ ℝ&lt;sup&gt;1×32×96&lt;/sup&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="245" x="545" y="410" as="geometry" />
        </mxCell>
        <mxCell id="transformer_11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#4776B8;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;Transformer encoder&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;3 encoder layers; 8 attention heads&lt;br&gt;Model width d=96; FFN width=192&lt;br&gt;GELU; pre-LayerNorm encoder layers&lt;br&gt;Final LayerNorm&lt;br&gt;Output B ∈ ℝ&lt;sup&gt;B×32×96&lt;/sup&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="255" x="825" y="395" as="geometry" />
        </mxCell>
        <mxCell id="cross_attention_12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAFE;strokeColor=#8064B6;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;Bidirectional cross-attention&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;A attends to B:&lt;br&gt;MHA(Q=A, K=B, V=B)&lt;br&gt;&lt;br&gt;B attends to A:&lt;br&gt;MHA(Q=B, K=A, V=A)&lt;br&gt;&lt;br&gt;Each path: residual + LayerNorm&lt;br&gt;Outputs A′, B′ ∈ ℝ&lt;sup&gt;B×32×96&lt;/sup&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="255" x="1120" y="255" as="geometry" />
        </mxCell>
        <mxCell id="fusion_13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAFE;strokeColor=#8064B6;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;Adaptive gated fusion&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;G = sigmoid(Linear([A′; B′]))&lt;br&gt;G ∈ (0,1)&lt;sup&gt;B×32×96&lt;/sup&gt;&lt;br&gt;&lt;br&gt;H₀ = LayerNorm(G⊙A′ + (1−G)⊙B′)&lt;br&gt;&lt;br&gt;Residual FFN: 96→192→96&lt;br&gt;H = H₀ + Dropout(FFN(LN(H₀)))&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="250" x="1130" y="600" as="geometry" />
        </mxCell>
        <mxCell id="pooling_14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#B98520;fontColor=#1D2939;fontFamily=Times New Roman;align=center;verticalAlign=middle;spacing=8;strokeWidth=1.6;shadow=0;fontSize=15;fontStyle=1" value="&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.15;&quot;&gt;Temporal pooling&lt;/div&gt;&lt;div style=&quot;color: rgb(29, 41, 57); text-align: center; line-height: 1.25; margin-top: 6px;&quot;&gt;Concatenate:&lt;br&gt;mean(H)&lt;br&gt;max(H)&lt;br&gt;last token&lt;br&gt;&lt;br&gt;Vector = 3d = 288&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="150" x="810" y="630" as="geometry" />
        </mxCell>
